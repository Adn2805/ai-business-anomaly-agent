# Synthetic demonstration input. Replace with your real daily export.
EXCEL_PATH=data/sample_business_data.xlsx
BASELINE_WINDOW=7
ANOMALY_THRESHOLD=20
REPORTS_DIR=reports
DATABASE_DIR=state

# Empty SMTP settings disable sending. No credentials are needed for dry-run.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
SMTP_TIMEOUT=30

# Container timezone only. Configure the host cron timezone separately.
TZ=Asia/Kolkata
